{
  "cmake.generator": "Unix Makefiles",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "clangd.path": "C:/tools/msys64/clang64/bin/clangd.exe",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/out/build/windows-clang-msys2",
