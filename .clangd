CompileFlags:
  CompilationDatabase: out/build/default
  Add:
    - "-std=c++2c"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/eigen3"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/libxml2"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/miniz"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/openblas"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/opencv4"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/openjpeg-2.5"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/opus"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/skia"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/srt"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/svt-av1"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/vma"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/vpl"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/webgpu_upstream"
    - "-isystem"
    - "C:/vcpkg/installed/x64-windows-release/include/webp"
    - "-isystem"
    - "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.4/include"
    - "-isystem"
    - "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.4/include/cccl"
    - "-isystem"
    - "C:/Program Files/NVIDIA/CUDNN/v9.26/include/12.9"
  Remove: ["-external:*", "-std:c++latest"]
---
If:
  PathMatch: [.*\.h, .*\.cc]
  PathExclude: src/.*
CompileFlags:
  BuiltinHeaders: QueryDriver
  Add:
    - "-ID:/Developers/XER3/src"
    - "-I./package/module/node_modules/nan"
  Remove: ["-W*"]
  Compiler: clang++
