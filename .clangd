# XER3 — MSYS2 clang64 toolchain (supersedes the old vcpkg config).
# The active preset's compile database already carries every -I/-D
# per file; regenerate it with `cmake --preset windows-clang-msys2`.
CompileFlags:
  CompilationDatabase: out/build/windows-clang-msys2
  Add:
    - "-std=c++23"
    # System dep headers the compile db references via -isystem —
    # clangd resolves them anyway, but listing key ones speeds up
    # background indexing of headers included transitively.
    - "-isystem"
    - "C:/tools/msys64/clang64/include/c++/v1"
    - "-isystem"
    - "C:/tools/msys64/clang64/include"
    - "-isystem"
    - "C:/tools/msys64/clang64/include/skia/include"
    - "-isystem"
    - "C:/tools/msys64/clang64/include/opencv5"
    - "-isystem"
    - "D:/Developers/XER3/third_party/cef/cef_windows64/include"
    - "-isystem"
    - "D:/Developers/XER3/third_party/fxdiv/include"
    - "-isystem"
    - "D:/Developers/XER3/third_party/pthreadpool/include"
  Remove: ["-external:*"]
---
# Sources outside src/ (tools/, tests/) — clang's builtin headers via
# the real driver so <intrin.h>/libc++ resolve against clang64.
If:
  PathMatch: [.*\.h, .*\.cc]
  PathExclude: src/.*
CompileFlags:
  BuiltinHeaders: QueryDriver
  Add:
    - "-ID:/Developers/XER3/src"
    - "-isystem"
    - "C:/tools/msys64/clang64/include/c++/v1"
    - "-isystem"
    - "C:/tools/msys64/clang64/include"
  Compiler: C:/tools/msys64/clang64/bin/clang++.exe
