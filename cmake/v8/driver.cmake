cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED XER_V8_SETTINGS OR NOT EXISTS "${XER_V8_SETTINGS}")
    message(FATAL_ERROR "Configure XER with ENABLE_V8=ON before invoking the V8 driver.")
endif()
if(NOT XER_V8_ACTION MATCHES "^(fetch|configure|build)$")
    message(FATAL_ERROR "XER_V8_ACTION must be fetch, configure or build.")
endif()
include("${XER_V8_SETTINGS}")
find_package(Git REQUIRED)
set(ENV{DEPOT_TOOLS_WIN_TOOLCHAIN} 0)
set(ENV{DEPOT_TOOLS_UPDATE} 0)
set(ENV{DEPOT_TOOLS_METRICS} 0)
set(ENV{PATH} "${XER_DEPOT_TOOLS_DIR};${XER_V8_VCPKG_PREFIX}/bin;$ENV{PATH}")

function(xer_v8_run directory)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
        RESULT_VARIABLE result COMMAND_ECHO STDOUT)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "V8 ${XER_V8_ACTION} failed (${result}). See the command output above.")
    endif()
endfunction()

function(xer_v8_check_revision directory revision)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" rev-parse HEAD
        OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT actual STREQUAL revision)
        message(FATAL_ERROR "${directory} is not at the pinned revision ${revision}. Use a separate checkout; existing work will not be reset.")
    endif()
endfunction()

get_filename_component(workspace "${XER_V8_SOURCE_DIR}" DIRECTORY)
get_filename_component(source_name "${XER_V8_SOURCE_DIR}" NAME)
file(MAKE_DIRECTORY "${workspace}")
file(LOCK "${workspace}/xer-v8.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE lock_result)
if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "Another XER V8 operation is using ${workspace}: ${lock_result}")
endif()
if(XER_V8_ACTION STREQUAL "fetch")
    if(NOT EXISTS "${XER_DEPOT_TOOLS_DIR}")
        get_filename_component(depot_parent "${XER_DEPOT_TOOLS_DIR}" DIRECTORY)
        file(MAKE_DIRECTORY "${depot_parent}")
        xer_v8_run("${depot_parent}" "${GIT_EXECUTABLE}" clone --no-checkout
            https://chromium.googlesource.com/chromium/tools/depot_tools.git "${XER_DEPOT_TOOLS_DIR}")
        xer_v8_run("${XER_DEPOT_TOOLS_DIR}" "${GIT_EXECUTABLE}" checkout --detach "${XER_DEPOT_TOOLS_REVISION}")
    endif()
    xer_v8_check_revision("${XER_DEPOT_TOOLS_DIR}" "${XER_DEPOT_TOOLS_REVISION}")
    xer_v8_run("${XER_DEPOT_TOOLS_DIR}" "${XER_DEPOT_TOOLS_DIR}/cipd_bin_setup.bat")
    xer_v8_run("${XER_DEPOT_TOOLS_DIR}" "${XER_DEPOT_TOOLS_DIR}/bootstrap/win_tools.bat")
    xer_v8_run("${XER_DEPOT_TOOLS_DIR}" "${XER_DEPOT_TOOLS_DIR}/vpython3.bat"
        "${XER_DEPOT_TOOLS_DIR}/gsutil.py" version)
    if(EXISTS "${XER_V8_SOURCE_DIR}")
        xer_v8_check_revision("${XER_V8_SOURCE_DIR}" "${XER_V8_REVISION}")
    endif()
    set(spec "solutions = [{'name': '${source_name}', 'url': 'https://chromium.googlesource.com/v8/v8.git', 'managed': False, 'custom_deps': {}, 'custom_vars': {}}]\n")
    if(EXISTS "${workspace}/.gclient")
        file(READ "${workspace}/.gclient" existing)
        if(NOT existing STREQUAL spec)
            message(FATAL_ERROR "An existing .gclient differs from the XER configuration. Use a dedicated XER_V8_SOURCE_DIR.")
        endif()
    else()
        file(WRITE "${workspace}/.gclient" "${spec}")
    endif()
    xer_v8_run("${workspace}" "${XER_DEPOT_TOOLS_DIR}/gclient.bat" sync
        "--revision=${source_name}@${XER_V8_REVISION}"
        "--jobs=${XER_V8_BUILD_JOBS}" --no-history --shallow)
    xer_v8_check_revision("${XER_V8_SOURCE_DIR}" "${XER_V8_REVISION}")
    return()
endif()

if(NOT EXISTS "${XER_V8_SOURCE_DIR}/include/v8.h")
    message(FATAL_ERROR "V8 sources are missing. Enable XER_FETCH_V8 and run xer_v8_fetch first, or set XER_V8_SOURCE_DIR to a prepared checkout.")
endif()
xer_v8_check_revision("${XER_V8_SOURCE_DIR}" "${XER_V8_REVISION}")
include("${CMAKE_CURRENT_LIST_DIR}/prepare.cmake")
set(gn "${XER_V8_SOURCE_DIR}/buildtools/win/gn.exe")
if(NOT EXISTS "${gn}")
    message(FATAL_ERROR "GN is missing at ${gn}. Complete xer_v8_fetch (including gclient hooks).")
endif()
xer_v8_run("${XER_V8_SOURCE_DIR}" "${gn}" gen "${XER_V8_BUILD_DIR}" --fail-on-unused-args)
if(XER_V8_ACTION STREQUAL "build")
    if(NOT EXISTS "${XER_V8_NINJA_EXECUTABLE}")
        message(FATAL_ERROR "Set XER_V8_NINJA_EXECUTABLE to an installed ninja.exe and reconfigure.")
    endif()
    xer_v8_run("${XER_V8_SOURCE_DIR}" "${XER_V8_NINJA_EXECUTABLE}"
        -C "${XER_V8_BUILD_DIR}" -j "${XER_V8_BUILD_JOBS}" v8_monolith)
endif()
