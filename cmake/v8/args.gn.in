is_debug = false
is_component_build = false
target_cpu = "x64"
v8_target_cpu = "x64"
v8_monolithic = true
v8_use_external_startup_data = false
v8_enable_i18n_support = true
icu_use_data_file = false
v8_use_zlib = true
v8_generate_external_defines_header = true
use_custom_libcxx = false
use_custom_libcxx_for_host = false
symbol_level = 0
xer_use_dynamic_crt = true
v8_icu_path = "//xer_vcpkg/icu"
v8_zlib_path = "//xer_vcpkg/zlib"
xer_vcpkg_include_dir = "@XER_V8_VCPKG_PREFIX@/include"
xer_vcpkg_icu_uc = "@XER_V8_ICU_UC@"
xer_vcpkg_icu_i18n = "@XER_V8_ICU_I18N@"
xer_vcpkg_icu_data = "@XER_V8_ICU_DATA@"
xer_vcpkg_zlib = "@XER_V8_ZLIB@"
