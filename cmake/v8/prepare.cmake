cmake_minimum_required(VERSION 3.21)
foreach(variable IN ITEMS XER_V8_SOURCE_DIR XER_V8_BUILD_DIR XER_V8_CONFIG_DIR)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        message(FATAL_ERROR "${variable} is required.")
    endif()
endforeach()
set(windows_gn "${XER_V8_SOURCE_DIR}/build/config/win/BUILD.gn")
if(NOT EXISTS "${windows_gn}")
    message(FATAL_ERROR "V8 dependencies are missing. Run the xer_v8_fetch target first.")
endif()
file(READ "${windows_gn}" original)
string(REPLACE "\r\n" "\n" patched "${original}")
set(declaration "declare_args() {\n  xer_use_dynamic_crt = false\n}")
if(NOT patched MATCHES "xer_use_dynamic_crt = false")
    string(FIND "${patched}" "assert(is_win)" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Unsupported V8 Windows CRT configuration: missing is_win assertion.")
    endif()
    string(REPLACE "assert(is_win)" "assert(is_win)\n\n${declaration}" patched "${patched}")
endif()
foreach(config IN ITEMS default_crt release_crt)
    set(before "config(\"${config}\") {\n  if (is_component_build)")
    set(after "config(\"${config}\") {\n  if (is_component_build || xer_use_dynamic_crt)")
    string(FIND "${patched}" "${after}" found)
    if(found EQUAL -1)
        string(FIND "${patched}" "${before}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Unsupported V8 Windows CRT configuration: ${config}.")
        endif()
        string(REPLACE "${before}" "${after}" patched "${patched}")
    endif()
endforeach()
if(NOT original STREQUAL patched)
    file(WRITE "${windows_gn}" "${patched}")
endif()
file(MAKE_DIRECTORY "${XER_V8_SOURCE_DIR}/xer_vcpkg" "${XER_V8_BUILD_DIR}")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/vcpkg.gni"
          "${CMAKE_CURRENT_LIST_DIR}/icu"
          "${CMAKE_CURRENT_LIST_DIR}/zlib"
    DESTINATION "${XER_V8_SOURCE_DIR}/xer_vcpkg")
configure_file("${XER_V8_CONFIG_DIR}/args.gn" "${XER_V8_BUILD_DIR}/args.gn" COPYONLY)
