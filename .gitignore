# Build directories
/build/
/*build*/
/build*/
/*build/
*/build/
/out/
*/out/
/.deps/
*/.deps/
/cmake-build-*/
*/cmake-build-*/
install/
*/install/

# Compatibility layer (removed in favor of real dependencies)
/compat/

# IDE and editor files
/.vscode/
/.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
# Allow cmake/ directory files
!cmake/*.cmake
!cmake/**/*.cmake

# Compiled Object files
*.o
*.obj
*.ko
*.elf

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.a
*.lib
*.ar

# Executables
*.exe
*.out
*.app
EngineBuilder
# Root-level Flux* build artifacts only — do NOT ignore src/flux/,
# src/ui/backends/flux/, or tests/ui/flux_* sources.
/Flux*

# Dependencies
/vendor/
/external/

# Audio and media files
*.mp3
*.wav
*.flac
*.ogg
*.mp4
*.avi
*.mkv
/models/

# Downloaded AI model weights (staged per
# tools/video_editor/assets/models/README.md — not committed)
/tools/video_editor/assets/models/*.onnx
/tools/video_editor/assets/models/*.bin
# SAM2.1 ships ONNX external-data pairs (weights in a sidecar
# .onnx_data blob) inside a per-model subdirectory.
/tools/video_editor/assets/models/*.onnx_data
/tools/video_editor/assets/models/sam21/

# Generated files
*.flowcache.*
*.flowcache.bin
*.flowcache.diff
*.flowcache.xml

# Test results
/test_results/
/coverage/

# Logs
*.log
/logs/

# Temporary files
*.tmp
*.temp
*.bak
*.cache

# OS specific
# Windows
*.user
*.suo
*.sln.docstates

# macOS
*.dSYM/
*.dSYM

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/

# Node.js (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# CEF binary distribution — installed locally by InstallCef.ps1,
# never committed (280MB+ binaries).
/third_party/cef/

# Vendored official ORT runtime binaries — committed on purpose,
# see third_party/VENDORED.md (onnxruntime/win-x64 section).
!/third_party/onnxruntime/win-x64/*.dll
nul
