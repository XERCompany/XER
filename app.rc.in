#include <winresrc.h>

IDI_ICON1 ICON "@XER_ICON_PATH@"

1 VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L    /* VOS_NT_WINDOWS32 */
 FILETYPE       0x1L        /* VFT_APP */
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "XERLab\0"
            VALUE "FileDescription",  "@TARGET_DESC@ - XER Creative Suite\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "@TARGET_NAME@\0"
            VALUE "LegalCopyright",   "Matvey Vladimirovich (Yoshi Arasaka & LXXV)\0"
            VALUE "OriginalFilename", "@TARGET_NAME@.exe\0"
            VALUE "ProductName",      "XER Creative Suite\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
            VALUE "Author",           "Matvey Vladimirovich (Yoshi Arasaka & LXXV)\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
