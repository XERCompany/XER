-- format: json
-- Full dependency inventory for the MSYS2 exit
-- (docs/wiki/architecture/msys2-exit-plan.md). Every dep the project
-- pulls from MSYS2 clang64 is declared here; build semantics:
--   "build_mode": "static"  (manifest default) -> cmake-gen emits
--   BUILD_SHARED_LIBS=OFF around upstream CMake wrappers and STATIC
--   source-list libraries.
-- "notes" marks route per the exit plan (B=cmake-buildable, P=prebuilt,
-- H=hard — needs w64devkit/custom build script, X=drop candidate).
{
    "automatic_update": true,
    "automatic_update_interval_days": 7,
    "automatic_update_check_on_start": true,
    "automatic_create_patch_for_cmake_all_dependencies": true,
    "prefix_new_version_all_dependencies": "XER-",
    "output_directory": "third_party",
    "build_mode": "static",
    "dependencies-from-github": [
        {
            "name": "abseil-cpp",
            "url": "https://github.com/abseil/abseil-cpp"
        },
        {
            "name": "libxml2",
            "url": "https://github.com/GNOME/libxml2"
        },
        {
            "name": "ffmpeg",
            "url": "https://git.ffmpeg.org/ffmpeg.git",
            "notes": "H: autotools-only (configure+make) — cmake-gen emits XER_FFMPEG_REQUIRES_CONFIGURE; real route is the ffmpeg-builds prebuilt dep or a w64devkit build"
        },
        {
            "name": "zlib",
            "url": "https://github.com/madler/zlib"
        },
        {
            "name": "brotli",
            "url": "https://github.com/google/brotli"
        },
        {
            "name": "libuv",
            "url": "https://github.com/libuv/libuv"
        },
        {
            "name": "fp16",
            "url": "https://github.com/Maratyszcza/fp16",
            "ref": "4dfe081cf6bcd15db339cf2680b9281b8451eeb3",
            "notes": "header-only; pinned to vcpkg port ref (VENDORED.md)"
        },
        {
            "name": "re2",
            "url": "https://github.com/google/re2"
        },
        {
            "name": "zstd",
            "url": "https://github.com/facebook/zstd",
            "notes": "upstream cmake lives in build/cmake — root-level source-list fallback also works"
        },
        {
            "name": "pthreadpool",
            "url": "https://github.com/Maratyszcza/pthreadpool",
            "ref": "a56dcd79c699366e7ac6466792c3025883ff7704",
            "notes": "source-list build; pinned to vcpkg port ref (VENDORED.md)"
        },
        {
            "name": "fxdiv",
            "url": "https://github.com/Maratyszcza/FXdiv",
            "ref": "63058eff77e11aa15bf531df5dd34395ec3017c8",
            "notes": "header-only; pinned to vcpkg port ref (VENDORED.md)"
        },
