-- format: json
{
    "automatic_update": true,
    "automatic_update_interval_days": 7,
    "automatic_update_check_on_start": true,
    "automatic_create_patch_for_cmake_all_dependencies": true,
    "prefix_new_version_all_dependencies": "XER-",
    "output_directory": "third_party",
    "dependencies-from-github": [
        {
            "name": "abseil-cpp",
            "url": "https://github.com/abseil/abseil-cpp"
        },
        {
            "name": "libxml2",
            "url": "https://github.com/GNOME/libxml2"
        },
        {
