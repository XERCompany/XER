        },
        {
            "name": "openvdb",
            "url": "https://github.com/AcademySoftwareFoundation/openvdb",
            "notes": "X drop candidate — only needed by a full-format OIIO build"
        },
        {
            "name": "dcmtk",
            "url": "https://github.com/DCMTK/dcmtk",
            "notes": "X drop candidate — only needed by a full-format OIIO build"
        },
        {
            "name": "opencv",
            "url": "https://github.com/opencv/opencv",
            "notes": "H (L): real cmake build ~30-45min — must source-build (C++ API under libc++); delay-load seam absorbs the DLL set"
        },
        {
            "name": "folly",
            "url": "https://github.com/facebook/folly",
            "notes": "H/X: link-only dep today — MSYS2's mingw folly is a patched port (XL to reproduce); prefer making find_package QUIET"
        },
        {
            "name": "llvm-project",
            "url": "https://github.com/llvm/llvm-project",
            "notes": "H (XL): only needed for pe_deps/llvm dev, libclang, VE JIT — llvm-mingw ships no dev libs; prefer pe_deps rewrite + feature gates (exit plan 2)"
        },
        {
            "name": "skia",
            "url": "https://skia.googlesource.com/skia",
            "notes": "H (XL, critical path): GN build (gn+ninja+depot_tools), C++ ABI locked to libc++ — biggest single risk per exit plan 3.4"
        },
        {
            "name": "v8",
            "url": "https://chromium.googlesource.com/v8/v8",
