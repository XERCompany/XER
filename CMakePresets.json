{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "binaryDir": "${sourceDir}/out/build/${presetName}-system",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_CUDA": "OFF",
        "ENABLE_CUDNN": "OFF",
        "ENABLE_AI": "OFF",
        "ENABLE_OPENCV": "OFF",
        "ENABLE_V8": "OFF",
        "ENABLE_MEDIA": "ON"
      }
    },
    {
      "name": "cuda",
      "displayName": "CUDA + cuDNN",
      "inherits": "default",
      "binaryDir": "${sourceDir}/out/build/${presetName}-system",
      "cacheVariables": {
        "ENABLE_CUDA": "ON",
        "ENABLE_CUDNN": "ON",
        "ENABLE_AI": "ON",
        "ENABLE_V8": "OFF"
      }
    },
    {
      "name": "v8",
      "displayName": "Source-built V8 runtime",
      "inherits": "default",
      "binaryDir": "${sourceDir}/out/build/${presetName}-system",
      "cacheVariables": {
        "ENABLE_V8": "ON",
        "XER_BUILD_LLVM": "ON",
        "ENABLE_MEDIA": "OFF"
      }
    },
    {
      "name": "opencv",
      "displayName": "OpenCV bridge libraries",
      "inherits": "default",
      "binaryDir": "${sourceDir}/out/build/${presetName}-system",
      "cacheVariables": {
        "ENABLE_OPENCV": "ON",
        "ENABLE_MEDIA": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "cuda",
      "configurePreset": "cuda"
    },
    {
      "name": "v8",
      "configurePreset": "v8",
      "targets": ["XERLLVMExternal", "XERV8External", "XERJavaScript", "XERSQLite3"]
    },
    {
      "name": "v8-xer",
      "configurePreset": "v8",
      "targets": ["XER"]
    },
    {
      "name": "opencv",
      "configurePreset": "opencv",
      "targets": ["XEROpenCV"]
    }
  ]
}